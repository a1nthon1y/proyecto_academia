# ────────────────────────────────────────────────────────────
# Configuración del backend - copiar a .env y completar valores
# ────────────────────────────────────────────────────────────

# Opción 1: cadena de conexión completa (Neon / Supabase / cloud)
# DATABASE_URL=postgresql://usuario:password@host:5432/basedatos?sslmode=require

# Opción 2: variables separadas (PostgreSQL local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=academ_db

# Secreto para firmar tokens JWT - usar uno largo y aleatorio en producción
JWT_SECRET=cambiar_por_un_string_aleatorio_largo

# Puerto donde escucha el servidor
PORT=4000
